{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "laravel-template",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ tests/e2e/ playwright.config.ts vite.config.ts",
        "format:check": "prettier --check resources/ tests/e2e/ playwright.config.ts vite.config.ts",
        "lint": "eslint . --fix",
        "types": "vue-tsc --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report tests/e2e/.report",
        "lint:check": "eslint ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "prettier": "^3.9.8",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-vue-next": "^1.0.0",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.43"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.3",
        "@rollup/rollup-win32-x64-msvc": "4.63.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
